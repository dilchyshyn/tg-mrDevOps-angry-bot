# Скопіюй у .env і заповни. .env не комітиться.

# Токен від @BotFather
BOT_TOKEN=

# Ключ Gemini API з Google AI Studio (без нього класифікатор і генерація цитат вимкнені)
GEMINI_API_KEY=

# Модель для класифікації та генерації (Flash, є безкоштовний рівень)
LLM_MODEL=gemini-2.5-flash
LLM_ENABLED=true

# static | generate | mixed
QUOTE_MODE=mixed

# Пауза між DevOps-цитатами в одному чаті, секунди. 0 = без паузи
COOLDOWN_SECONDS=0

# Коротші повідомлення ігноруються без виклику LLM
MIN_TEXT_LENGTH=8
