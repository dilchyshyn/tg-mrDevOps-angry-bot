# Скопіюй у .env і заповни. .env не комітиться.

# Токен від @BotFather
BOT_TOKEN=

# Ключ Gemini API з Google AI Studio. Без нього бот не відповідає на звертання
# і не генерує цитати, але DevOps-цитати з пулу і Красовська працюють.
GEMINI_API_KEY=

# Модель для відповідей на звертання і генерації цитат
LLM_MODEL=gemini-3.5-flash-lite
LLM_ENABLED=true

# static (пул по колу) | generate (LLM, при збої пул) | mixed (пул, далі LLM)
QUOTE_MODE=static

# Пауза між DevOps-цитатами в одному чаті, секунди. 0 = без паузи
COOLDOWN_SECONDS=0

# З цими людьми бот не грубить (без цитат, звертання ввічливо).
# Telegram ID або @username через кому, наприклад: @username,123456789
PROTECTED_USERS=

# До цих людей бот звертається як до королеви (на звертання і на DevOps-повідомлення).
# Формат як у PROTECTED_USERS, захист від грубощів діє автоматично
QUEEN_USERS=
